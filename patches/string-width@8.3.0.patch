 const extendedPictographicRegex = /\p{Extended_Pictographic}/gu;
 
+// ccmanager patch: under Bun (JavaScriptCore) one `\p{RGI_Emoji}` /v match costs
+// about 100µs, and Ink measures every line of the menu through here. A cluster
+// always gets the same answer, and the same few clusters repeat on every line,
+// so remember it.
+const EMOJI_CACHE_MAX_SIZE = 5000;
+const doubleWidthEmojiCache = new Map();
+
+function isDoubleWidthEmojiCluster(segment) {
+	let result = doubleWidthEmojiCache.get(segment);
+	if (result === undefined) {
+		result = rgiEmojiRegex.test(segment) || isDoubleWidthNonRgiEmojiSequence(segment);
+		if (doubleWidthEmojiCache.size >= EMOJI_CACHE_MAX_SIZE) {
+			doubleWidthEmojiCache.clear();
+		}
+
+		doubleWidthEmojiCache.set(segment, result);
+	}
+
+	return result;
+}
