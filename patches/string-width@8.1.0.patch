+		let width = shortInputWidthCache.get(input);
+		if (width === undefined) {
+			width = measureStringWidth(input);
+			if (shortInputWidthCache.size >= CACHE_MAX_SIZE) {
+				shortInputWidthCache.clear();
+			}
