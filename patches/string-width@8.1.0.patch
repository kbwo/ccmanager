-export default function stringWidth(input, options = {}) {
+// ccmanager patch: Ink measures every character of every rendered row with this
+// function, and under Bun (JavaScriptCore) a single call costs several
+// microseconds, which made one menu frame take ~85ms. The result for a given
+// short string never changes, so remember it.
+const SHORT_INPUT_MAX_LENGTH = 8;
+const CACHE_MAX_SIZE = 5000;
+const shortInputWidthCache = new Map();
+
+export default function stringWidth(input, options) {
+	if (
+		options === undefined
+		&& typeof input === 'string'
+		&& input.length <= SHORT_INPUT_MAX_LENGTH
